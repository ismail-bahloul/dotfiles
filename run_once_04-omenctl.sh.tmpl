#!/bin/bash
# =============================================================================
# run_once_04-omenctl.sh.tmpl
# Run once by chezmoi (re-runs if this file changes)
# Install the omenctl systemd units + udev rules (fans + power profiles).
#
# omenctl itself is installed by run_once_03-omenctl.sh. This script also
# retires the legacy power-profile stack (bash script, timer, watcher, udev).
# The hash below covers the etc/ files this script installs, so chezmoi re-runs
# it when one of them changes (a plain run_once_ would not notice).
# etc-hash: {{ range list "etc/systemd/system/omenctl-profile.service" "etc/systemd/system/omenctl-profile.timer" "etc/systemd/system/omenctl-watch.service" "etc/udev/rules.d/99-omenctl.rules" "etc/udev/rules.d/99-powercap.rules" "etc/udev/rules.d/99-rme-babyface.rules" }}{{ include . | sha256sum | trunc 8 }}{{ end }}
# =============================================================================
set -e

# Logging helpers: .lib_logging.sh ships in the chezmoi source dir and is always
# present when run_once scripts run under chezmoi, so no fallback is needed.
source "${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/.lib_logging.sh"

SCRIPT_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
source "$SCRIPT_DIR/.lib_system.sh"

log_info "Installing omenctl units..."

# Disable power-profiles-daemon if present (conflicts with our setup)
if [ -f /usr/lib/systemd/system/power-profiles-daemon.service ]; then
  log_info "power-profiles-daemon detected, masking it..."
  sudo systemctl mask --now power-profiles-daemon.service 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Retire the legacy power-profile stack
# ---------------------------------------------------------------------------
# `omenctl profile` and `omenctl watch` replace the bash script and its
# watcher. Remove the units, the udev rule and the /usr/local/bin symlinks:
# a stale unit left enabled would keep writing the CPU/GPU limits.
log_info "Removing the legacy power-profile units..."
sudo systemctl disable --now power-profile.service power-profile.timer power-profile-watch.service 2>/dev/null || true
sudo rm -f \
  /etc/systemd/system/power-profile.service \
  /etc/systemd/system/power-profile.timer \
  /etc/systemd/system/power-profile-watch.service \
  /etc/udev/rules.d/99-power-profile.rules
sudo rm -f /usr/local/bin/power-profile /usr/local/bin/power-profile-watch
rm -f "$HOME/.local/bin/power-profile" "$HOME/.local/bin/power-profile-watch"
# Old names from the ryzenadj-profile era.
sudo rm -f /etc/systemd/system/ryzenadj-profile.service /etc/systemd/system/ryzenadj.service /etc/systemd/system/ryzenadj.timer /etc/udev/rules.d/99-ryzenadj-profile.rules
sudo systemctl daemon-reload 2>/dev/null || true

# ---------------------------------------------------------------------------
# omenctl must already be installed (run_once_03-omenctl.sh)
# ---------------------------------------------------------------------------
for f in /usr/local/bin/omenctl /usr/local/bin/omenctl-run.sh /etc/systemd/system/omenctl.service; do
  if [ ! -e "$f" ]; then
    log_fatal "$f is missing; run run_once_03-omenctl.sh first"
  fi
done

# ---------------------------------------------------------------------------
# Install the units and udev rules
# ---------------------------------------------------------------------------
for f in \
  etc/systemd/system/omenctl-profile.service \
  etc/systemd/system/omenctl-profile.timer \
  etc/systemd/system/omenctl-watch.service; do
  install_system_file "$f" || true
done
for f in \
  etc/udev/rules.d/99-omenctl.rules \
  etc/udev/rules.d/99-powercap.rules \
  etc/udev/rules.d/99-rme-babyface.rules; do
  install_system_file "$f" || true
done

# ---------------------------------------------------------------------------
# Enable and (re)start
# ---------------------------------------------------------------------------
sudo systemctl daemon-reload
sudo systemctl enable omenctl.service omenctl-profile.service omenctl-profile.timer omenctl-watch.service
# The fan daemon is long-running: `start` is a no-op if it already owns the
# fans. A restart would release the latch and re-take it for no reason.
sudo systemctl start omenctl.service
sudo systemctl restart omenctl-profile.service
sudo systemctl restart omenctl-profile.timer
sudo systemctl restart omenctl-watch.service

# Enable NVIDIA services (suspend/resume only)
sudo systemctl enable nvidia-suspend.service nvidia-resume.service 2>/dev/null || true

# Reload udev rules
sudo udevadm control --reload-rules

log_pass "omenctl units installed."
