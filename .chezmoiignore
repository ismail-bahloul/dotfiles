# .chezmoiignore — files in the source dir that chezmoi should NOT deploy.
# chezmoi deploys every entry of the source dir (the dot_ prefix only renames
# it to a leading dot), so anything that must stay repo-only is listed below.


# Package registry: one <component>.{pacman,aur} per component, read by
# run_once_01-packages.sh.tmpl (not deployed to ~/)
packages.d
README.md
LICENSE
validate.sh
install.sh
test.sh
.lib_logging.sh
.lib_system.sh

# System files installed by run_onchange_03, run_once_04 and run_once_11 (not deployed to ~/)
etc

# Investigation notes + evidence, kept for the record (not deployed to ~/)
docs

# Git/GitHub metadata for the repo itself (not deployed to ~/)
.gitattributes
.gitignore

# Windows-side helpers (not deployed to ~/)
win

# Python bytecode caches (regenerated at runtime next to the scripts)
**/__pycache__

# Local secrets (API keys, tokens) — never versioned
dot_config/zsh/secrets
