#!/bin/bash
# =============================================================================
# bricks/install — install an opt-in package bundle ("brick").
#
# The core (drivers, shell, KDE, VM, audio stack, theming) lives in packages.d/
# and is installed by chezmoi. A brick is everything that is an *application*
# rather than a dependency of a versioned config: you install it by hand, when
# you want it. The dotfiles never install a brick on their own, so adding or
# dropping one cannot break `chezmoi apply`.
#
# Usage:
#   ./bricks/install --list
#   ./bricks/install audio-apps
#   ./bricks/install audio-apps creative
#
# Nothing is uninstalled automatically: remove a brick with
#   sudo pacman -Rns <packages>
# =============================================================================
set -e

DIR=$(cd "$(dirname "$0")" && pwd)

list_bricks() {
  local f name n
  for f in "$DIR"/*.pacman; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .pacman)
    n=$(awk '!/^[[:space:]]*#/ && NF {c++} END {print c+0}' "$DIR/$name".*)
    printf '  %-12s %s packages\n' "$name" "$n"
  done
}

gather() { # $1 = brick, $2 = pacman|aur
  local f="$DIR/$1.$2"
  [ -f "$f" ] || return 0
  awk '!/^[[:space:]]*#/ && NF {print $1}' "$f"
}

case "${1:-}" in
  --list|-l)
    echo "Bricks:"
    list_bricks
    exit 0
    ;;
  ""|-h|--help)
    sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

# Validate every name first, so a typo cannot half-install a set.
for b in "$@"; do
  if [ ! -f "$DIR/$b.pacman" ] && [ ! -f "$DIR/$b.aur" ]; then
    echo "Unknown brick: $b (try --list)" >&2
    exit 1
  fi
done

for b in "$@"; do
  mapfile -t pkg < <(gather "$b" pacman)
  mapfile -t aur < <(gather "$b" aur)
  echo "==> brick: $b"
  if [ "${#pkg[@]}" -gt 0 ]; then
    sudo pacman -S --needed --noconfirm "${pkg[@]}"
  fi
  if [ "${#aur[@]}" -gt 0 ]; then
    if ! command -v paru >/dev/null 2>&1; then
      echo "paru is required for the AUR part of '$b'" >&2
      exit 1
    fi
    paru -S --needed --noconfirm "${aur[@]}"
  fi
done

echo "Done. Nothing is uninstalled automatically."
