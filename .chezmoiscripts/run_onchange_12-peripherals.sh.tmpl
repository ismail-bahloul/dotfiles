#!/bin/bash
# =============================================================================
# run_onchange_12-peripherals.sh.tmpl
# Run by chezmoi when this file changes.
# Peripherals: install the logid config for the Logitech MX Master 3S.
#
# OPTIONAL — configured only while the "peripherals" component is enabled. The
# logid package itself comes from packages.d/peripherals.aur (run_once_01),
# which sorts before this script.
#
# The etc-hash below covers the system file this script installs, so chezmoi
# re-runs it when that file changes.
# etc-hash: {{ range list "etc/logid.cfg" }}{{ include . | sha256sum | trunc 8 }}{{ end }}
# =============================================================================
set -e

# Logging helpers: lib/logging.sh ships in the chezmoi source dir and is always
# present when run_ scripts run under chezmoi, so no fallback is needed.
source "${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/lib/logging.sh"

{{ template "component-guard" (dict "name" "peripherals" "data" .) }}

SCRIPT_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
source "$SCRIPT_DIR/lib/system.sh"

if ! command -v logid &>/dev/null; then
  log_skip "logid not installed (peripherals package missing)"
  exit 0
fi

# --- Logitech mouse (MX Master 3S) ------------------------------------------
log_info "Configuring Logitech MX Master 3S..."
# /etc/logid.cfg is versioned under etc/ (the repo mirrors /), so validate.sh
# compares it with the installed copy.
if install_system_file etc/logid.cfg; then
  sudo systemctl restart logid.service 2>/dev/null || true
fi
sudo systemctl enable --now logid.service 2>/dev/null || true
log_pass "logid configured."
