#!/bin/bash
# =============================================================================
# run_once_01-packages.sh.tmpl
# Run once by chezmoi, and re-run whenever the rendered content changes — i.e.
# whenever the `components` list in the chezmoi data changes.
#
# Packages come from packages.d/<component>.{pacman,aur}. One rule:
#   - every component owns a packages.d/<component>.pacman (possibly with no
#     package at all, when its packages are installed by its own script);
#   - <component>.aur is optional.
# `base` is always installed; the other components are installed only when
# listed in `.components`. A config that has no `components` key at all (one
# written before the registry existed) keeps the old behaviour: every known
# component except wine, which stays explicitly opt-in.
# =============================================================================
{{ $hasComponents := hasKey . "components" }}
{{ $components := list }}{{ if $hasComponents }}{{ $components = index . "components" }}{{ end }}
{{ if and (hasKey . "wine") (index . "wine") }}{{ $components = append $components "wine" }}{{ end }}
set -e

# Logging helpers: lib/logging.sh ships in the chezmoi source dir and is always
# present when run_once scripts run under chezmoi, so no fallback is needed.
source "${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/lib/logging.sh"

# Ensure paru is available
if ! command -v paru &>/dev/null; then
  log_fatal "paru is not installed. Run install.sh first."
fi

SCRIPT_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
PKG_DIR="$SCRIPT_DIR/packages.d"

# Components whose packages to install: base + the enabled ones.
CONFIGURED_COMPONENTS=({{ range $components }}"{{ . }}" {{ end }})
if {{ if $hasComponents }}true{{ else }}false{{ end }}; then
  COMPONENTS=(base "${CONFIGURED_COMPONENTS[@]}")
else
  # No `components` key: enumerate the registry (minus wine, still opt-in).
  COMPONENTS=(base)
  for f in "$PKG_DIR"/*.pacman; do
    comp="${f##*/}"; comp="${comp%.pacman}"
    if [ "$comp" != "base" ] && [ "$comp" != "wine" ]; then
      COMPONENTS+=("$comp")
    fi
  done
  {{ if has "wine" $components }}
  COMPONENTS+=(wine)
  {{ end }}
fi

# Ensure passwordless sudo for the wheel group. This is deliberate and
# load-bearing: chezmoi runs every run_once_* script non-interactively, so a
# sudo password prompt would hang `chezmoi apply`. The sudo keepalive in
# install.sh only covers the initial bootstrap. On this single-user laptop
# "%wheel" is effectively the only account, so this is the intended tradeoff.
# (Narrowing it to a command allowlist would have to cover the whole
# pacman/paru/systemctl/tee/install/sed/udevadm surface -- not worth it.)
if ! sudo grep -q "%wheel.*NOPASSWD" /etc/sudoers.d/* 2>/dev/null; then
  echo "%wheel ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/99-wheel-nopasswd > /dev/null
fi

parse_list() {
  grep -v '^\s*#' "$1" | grep -v '^\s*$' | awk '{print $1}'
}

# Concatenate every enabled component's list for one package manager, keeping
# the first occurrence of a package (the same package may be listed twice when
# a component depends on another).
collect() {
  local comp f
  for comp in "${COMPONENTS[@]}"; do
    f="$PKG_DIR/$comp.$1"
    if [ -f "$f" ]; then
      parse_list "$f" || true
    fi
  done | awk 'NF && !seen[$0]++'
}

# A name in `components` that owns no file is a typo, not an empty component.
for comp in "${COMPONENTS[@]}"; do
  if [ ! -f "$PKG_DIR/$comp.pacman" ] && [ ! -f "$PKG_DIR/$comp.aur" ]; then
    log_warn "unknown component '$comp' (no packages.d/$comp.pacman) — ignored"
  fi
done

# --- Replace jack2 with pipewire-jack ----------------------------------------
if pacman -Q jack2 &>/dev/null; then
  log_info "jack2 detected, replacing with pipewire-jack..."
  sudo pacman -Rdd --noconfirm jack2
fi

# --- Official packages -------------------------------------------------------
log_info "Installing pacman packages (components: ${COMPONENTS[*]})..."
mapfile -t pacman_pkgs < <(collect pacman)
if [ "${#pacman_pkgs[@]}" -gt 0 ]; then
  sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
fi

# --- AUR packages ------------------------------------------------------------
log_info "Installing AUR packages..."
mapfile -t aur_pkgs < <(collect aur)
if [ "${#aur_pkgs[@]}" -gt 0 ]; then
  paru -S --needed --noconfirm "${aur_pkgs[@]}"
fi

{{ if has "audio_pro" $components -}}
log_info "Adding user to realtime group for audio..."
sudo usermod -aG realtime "$USER"
{{ end -}}

# Ensure user is in wheel group for passwordless sudo
log_info "Ensuring user is in wheel group..."
sudo usermod -aG wheel "$USER"
log_pass "Packages installed successfully."
