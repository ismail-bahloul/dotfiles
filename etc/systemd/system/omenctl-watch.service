# Installed by run_once_04-omenctl.sh (dotfiles).
#
# The timer polls every 5 min, but writing platform_profile makes the EC
# re-apply its own limits within a second, so the machine could sit clobbered
# for almost the whole interval. inotify does work on that sysfs attribute, so
# this reacts to the write instead of polling.
#
# This is `omenctl watch` (github.com/ismail-bahloul/omenctl): it also polls the
# SMU limits for drift that writes nothing, and re-applies the stored mode
# in-process. The timer stays as a backstop for anything neither path notices.
[Unit]
Description=omenctl watch - re-apply the stored mode when the EC clobbers it

[Service]
Type=simple
ExecStart=/usr/local/bin/omenctl watch
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
