#!/bin/bash
# power-profile - CPU/GPU power profiles for Ryzen 5800H
set -uo pipefail

log() { logger -t "power-profile" "$@"; }

# Write a value to all CPU sysfs files (e.g., scaling_governor, scaling_max_freq)
# Reports errors via log instead of silencing them
write_cpu_sysfs() {
  local file="$1" val="$2"
  for cpu in /sys/devices/system/cpu/cpu*/cpufreq/"$file"; do
    if [ -f "$cpu" ]; then
      echo "$val" > "$cpu" 2>/dev/null || log "WARN: $cpu write failed ($val)"
    fi
  done
}

# The iGPU/SoC DPM level is an idle-power lever on battery: `low` drops mclk/fclk
# 1600->400 MHz and an idle session from ~14.5 W to ~11.5 W, with no measured
# effect on hardware video decode or the 144 Hz panel mode. It does cost CPU
# memory bandwidth (~-43%), so it is battery-only. See myomen15/efficiency.md.
# The card number is not stable, so find the amdgpu device that owns pp_dpm_fclk
# (the dGPU has no such node).
igpu_dpm_level() {
  local dev
  for dev in /sys/class/drm/card*/device; do
    if [ -e "$dev/pp_dpm_fclk" ]; then echo "$dev/power_dpm_force_performance_level"; return 0; fi
  done
  return 1
}
set_igpu_dpm() {
  local lvl="$1" path
  path=$(igpu_dpm_level)
  if [ -z "$path" ]; then log "WARN: no amdgpu DPM node found"; return 0; fi
  [ "$(cat "$path" 2>/dev/null)" = "$lvl" ] && return 0   # already there: no log spam from the guard
  echo "$lvl" > "$path" 2>/dev/null && log "iGPU DPM level -> $lvl" || log "WARN: $path write failed ($lvl)"
}

# The RTX 3070 is bound to vfio-pci on the default Limine entry (and parked in
# D3cold). When the nvidia driver does not own it, every `nvidia-smi` call costs
# ~0.8 s and fails -- two of them in a profile apply is ~1.6 s added to the boot
# critical path for nothing. The PCI binding symlink answers instantly, so gate
# on it. (Same test `info` already uses for its dGPU row.)
nvidia_ready() {
  [ "$(readlink "/sys/bus/pci/devices/0000:01:00.0/driver" 2>/dev/null | xargs basename 2>/dev/null)" = "nvidia" ]
}

# Log the SMU limits currently in effect. Called once per boot, before the first
# apply, so the journal records what the firmware seeded at POST. That is how you
# tell whether a BIOS "System Configuration" change actually took effect: the
# BIOS values are a POST-time seed only, and this service overwrites them ~12 s later.
log_current_limits() {
    local limits
    limits=$(/usr/bin/ryzenadj --info 2>/dev/null | awk -F'|' '
        /STAPM LIMIT|PPT LIMIT FAST|PPT LIMIT SLOW|THM LIMIT CORE/ {
            name=$2; val=$3
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            printf "%s=%s ", name, val
        }')
    [ -n "$limits" ] && log "firmware/POST limits: ${limits% }"
}

# ------ Settings ------
GPU_AC=1800
GPU_AC_MIN=500   # AC frequency floor: avoids deep P8 sleep (cause of mini-freezes when launching an app)
GPU_BAT=400
TDP_AC=28000     # AC power cap -- does the cooling (myomen15/efficiency.md)
TDP_BAT=15000
TEMP_AC=85
TEMP_BAT=65
FAST_AC=36000
FAST_BAT=18000
FREQ_AC=4465000  # no artificial frequency cap; the power cap binds only under load
FREQ_BAT=2400000

# ------ Performance (unlocked) ------
apply_perf() {
    log "PERF profile: 4.47 GHz / 54W / GPU unlocked"
    write_cpu_sysfs scaling_governor performance
    write_cpu_sysfs scaling_max_freq 4465000
    write_cpu_sysfs energy_performance_preference performance
    /usr/bin/ryzenadj --stapm-limit=54000 --fast-limit=65000 --slow-limit=54000 \
             --apu-slow-limit=42000 --tctl-temp=90 || log "WARN: ryzenadj perf failed"
    if nvidia_ready; then
        nvidia-smi -rmc > /dev/null 2>&1 || true           # memory: release the battery mem lock
        nvidia-smi -lgc 500,2100 > /dev/null 2>&1 || true   # graphics: unlocked ceiling, floor kept (deep P8 sleep = mini-freezes)
    fi
    iw dev wlan0 set power_save off 2>/dev/null || true
    set_igpu_dpm auto   # perf: the memory/fabric clocks stay free
    echo ">>> PERF mode: CPU 4.47 GHz / 54W / GPU unlocked"
    log "OK: CPU 4.47 GHz / 54W, GPU unlocked"
}

apply_ac() {
    log "AC profile: no freq cap / $((TDP_AC / 1000))W / GPU ${GPU_AC} MHz"
    write_cpu_sysfs scaling_governor powersave
    write_cpu_sysfs scaling_max_freq "${FREQ_AC}"
    write_cpu_sysfs energy_performance_preference balance_power
    /usr/bin/ryzenadj --stapm-limit=${TDP_AC} --fast-limit=${FAST_AC} --slow-limit=${TDP_AC} \
             --apu-slow-limit=22000 --tctl-temp=${TEMP_AC} 2>&1 || log "WARN: ryzenadj AC failed"
    if nvidia_ready; then
        nvidia-smi -rmc > /dev/null 2>&1 || true   # release the mem lock battery set (myomen15/dgpu-control.md)
        nvidia-smi -lgc ${GPU_AC_MIN},${GPU_AC} > /dev/null 2>&1 || true
    fi
    iw dev wlan0 set power_save off 2>/dev/null || true
    set_igpu_dpm auto   # AC: no power to save, keep the memory bandwidth
    echo ">>> AC mode: CPU no freq cap / $((TDP_AC / 1000))W / GPU ${GPU_AC_MIN}–${GPU_AC} MHz (mem: dynamic)"
    log "OK: CPU no freq cap / $((TDP_AC / 1000))W, GPU ${GPU_AC_MIN}-${GPU_AC} MHz (mem: auto)"
}

apply_battery() {
    log "Battery profile: $((FREQ_BAT / 1000000)).$(( (FREQ_BAT / 100000) % 10 )) GHz / $((TDP_BAT / 1000))W / GPU ${GPU_BAT} MHz"
    write_cpu_sysfs scaling_governor powersave
    write_cpu_sysfs scaling_max_freq "${FREQ_BAT}"
    write_cpu_sysfs energy_performance_preference power
    /usr/bin/ryzenadj --stapm-limit=${TDP_BAT} --fast-limit=${FAST_BAT} --slow-limit=${TDP_BAT} \
             --apu-slow-limit=15000 --tctl-temp=${TEMP_BAT} --power-saving 2>&1 || log "WARN: ryzenadj battery failed"
    if nvidia_ready; then
        nvidia-smi -lgc 0,${GPU_BAT} > /dev/null 2>&1 || true
        nvidia-smi -lmc 405 > /dev/null 2>&1 || true
    fi
    iw dev wlan0 set power_save on 2>/dev/null || true
    set_igpu_dpm low   # battery: ~-3 W idle; costs CPU memory bandwidth (myomen15/efficiency.md)
    echo ">>> BATTERY mode: CPU $((FREQ_BAT / 1000000)).$(( (FREQ_BAT / 100000) % 10 )) GHz / $((TDP_BAT / 1000))W / GPU ${GPU_BAT} MHz"
    log "OK: CPU $((FREQ_BAT / 1000000)).$(( (FREQ_BAT / 100000) % 10 )) GHz / $((TDP_BAT / 1000))W, GPU ${GPU_BAT} MHz"
}

# ------ Main ------
case "${1:-balanced}" in
    perf|performance)
        apply_perf  ;;
    ac|plugged)
        apply_ac  ;;
    battery|onbattery)
        apply_battery  ;;
    auto|balanced|guard)
        # Record the firmware-seeded limits once per boot (see log_current_limits).
        if [ ! -e /run/power-profile.boot-seen ]; then
            log_current_limits
            : > /run/power-profile.boot-seen 2>/dev/null || true
        fi
        # guard: periodic re-apply (EC/firmware override workaround) - never clobber manual perf mode
        if [ "${1:-}" = "guard" ] && [ "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)" = "performance" ]; then
            log "guard: PERF mode active, re-apply ignored"
            exit 0
        fi
        online=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 0)
        if [ "$online" = "1" ]; then
            apply_ac
        else
            apply_battery
        fi
        ;;
    info)
        gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
        freq_khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null)
        freq_ghz=$(awk "BEGIN { printf \"%.2f\", $freq_khz / 1000000 }" 2>/dev/null)

        temp_cpu=$(sensors 2>/dev/null | grep -E "^Tctl" | awk '{print $2}' | tr -d '+')
        temp_igpu=$(sensors 2>/dev/null | grep -E "^edge" | awk '{print $2}' | tr -d '+')

        # Detect active mode + power source
        online=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 0)
        if [ "$online" = "1" ]; then
            pwr="AC"
        else
            pwr="BATTERY"
        fi

        if [ "$gov" = "performance" ]; then
            mode_label="PERF ($pwr)"
        else
            mode_label="BALANCED ($pwr)"
        fi

        echo "┌────────────────────────────────────────────┐"
        printf "│ %-42s │\n" "Ryzen 5800H — $mode_label"
        echo "├────────────────────────────────────────────┤"
        printf "│ CPU          │ %-26s │\n" "$gov @ ${freq_ghz}GHz"

        limits=$(ryzenadj --info 2>/dev/null | grep -E "STAPM|PPT" | head -6)
        while IFS='|' read -r raw; do
            label=$(echo "$raw" | awk -F'|' '{print $2}' | xargs | sed 's/ LIMIT//;s/ VALUE//')
            val=$(echo "$raw" | awk -F'|' '{print $3}' | xargs)
            [ -n "$label" ] && printf "│ %-12s │ %s W        │\n" "$label" "$val"
        done <<< "$limits"

        echo "├────────────────────────────────────────────┤"

        if [ -n "$temp_cpu" ]; then
            printf "│ %-12s │ %-26s │\n" "CPU temp" "$temp_cpu"
        fi
        if [ -n "$temp_igpu" ]; then
            printf "│ %-12s │ %-26s │\n" "iGPU temp" "$temp_igpu"
        fi
        dpm=$(cat "$(igpu_dpm_level 2>/dev/null)" 2>/dev/null)
        if [ -n "$dpm" ]; then
            printf "│ %-12s │ %-26s │\n" "iGPU DPM" "$dpm"
        fi

        # NVIDIA (skip if unavailable)
        nvidia_pci="0000:01:00.0"
        nvidia_driver=$(readlink "/sys/bus/pci/devices/${nvidia_pci}/driver" 2>/dev/null | xargs basename 2>/dev/null)
        
        if [ "$nvidia_driver" = "vfio-pci" ]; then
            echo "├────────────────────────────────────────────┤"
            printf "│ dGPU          │ %-26s │\n" "VFIO (off)"
        else
            nvidia=""
            nvidia=$(nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader 2>/dev/null) || true
            if echo "$nvidia" | grep -qP '^\d+'; then
                echo "├────────────────────────────────────────────┤"
                nvidia_temp=$(echo "$nvidia" | awk -F', ' '{print $1}')
                nvidia_pwr=$(echo "$nvidia" | awk -F', ' '{print $2}')
                printf "│ dGPU temp   │ %-26s │\n" "${nvidia_temp}°C"
                printf "│ dGPU power  │ %-26s │\n" "$nvidia_pwr"
            fi
        fi

        echo "├────────────────────────────────────────────┤"

        nbfc_data=$(nbfc status 2>/dev/null) || true
        sys_temp=$(echo "$nbfc_data" | awk -F': ' '/Temperature/{t=$2} END{print t}')
        fan_speed=$(echo "$nbfc_data" | awk -F': ' '/Current Fan Speed/{s=$2} END{print s}')
        if [ -n "$sys_temp" ]; then
            printf "│ %-12s │ %-26s │\n" "System temp" "$sys_temp"
        fi
        if [ -n "$fan_speed" ]; then
            printf "│ %-12s │ %-26s │\n" "Fans speed" "$fan_speed"
        fi

        echo "└────────────────────────────────────────────┘"
        ;;
    *)
        echo "Usage: $0 {balanced|perf|ac|battery|guard|info}"
        exit 1
        ;;
esac
