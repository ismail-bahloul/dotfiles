#!/bin/bash
# =============================================================================
# deploy-plugins.sh — Deploys Linux audio plugins to the standard paths
#
# Fully dynamic: inspects each folder in Native_Linux/ and automatically
# detects the formats to deploy (VST3, LV2, CLAP, Standalone).
#
# Usage:
#   ./deploy-plugins.sh                     # real copy (default)
#   ./deploy-plugins.sh --link              # symbolic link
#   ./deploy-plugins.sh --dry-run           # simulation only
#   ./deploy-plugins.sh --bridged           # also configure yabridge plugins
#   ./deploy-plugins.sh --clean             # only clean dead links
# =============================================================================

set -euo pipefail

# ---- Config ----------------------------------------------------------------
REPO_DIR="$HOME/DATA/07_Softwares/Linux/Audio_Plugins"
NATIVE_DIR="$REPO_DIR/Native_Linux"
BRIDGED_DIR="$REPO_DIR/Bridged_Windows"

MODE="copy"
DRY_RUN=false
DEPLOY_BRIDGED=false
CLEAN_ONLY=false

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ---- Arguments -------------------------------------------------------------
for arg in "$@"; do
    case "$arg" in
        --link|--links|--symlink)
            MODE="symlink"
            ;;
        --copy)
            MODE="copy"
            ;;
        --dry-run)
            DRY_RUN=true
            ;;
        --bridged)
            DEPLOY_BRIDGED=true
            ;;
        --clean)
            CLEAN_ONLY=true
            ;;
        --help|-h)
            echo "Usage: $0 [--link|--copy] [--dry-run] [--bridged] [--clean]"
            exit 0
            ;;
        *)
            echo -e "${RED}Error: unknown argument: $arg${NC}"
            echo "Usage: $0 [--link|--copy] [--dry-run] [--bridged] [--clean]"
            exit 1
            ;;
    esac
done

# ---- Architecture detection (for multi-arch plugins like Bertom) ------------
ARCH=$(uname -m)
ARCH_DIR=""

if [ "$ARCH" = "x86_64" ]; then
    if lscpu 2>/dev/null | grep -qi "avx2"; then
        ARCH_DIR=".avx2"
    elif lscpu 2>/dev/null | grep -qi "sse2"; then
        ARCH_DIR=".sse2"
    fi
elif [ "$ARCH" = "aarch64" ]; then
    ARCH_DIR=".arm64"
fi

# ---- Target directories ----------------------------------------------------
VST3_DIR="$HOME/.vst3"
LV2_DIR="$HOME/.lv2"
CLAP_DIR="$HOME/.clap"
VST_DIR="$HOME/.vst"
BIN_DIR="$HOME/.local/bin"

mkdir -p "$VST3_DIR" "$LV2_DIR" "$CLAP_DIR" "$VST_DIR" "$BIN_DIR"

# ---- Counters --------------------------------------------------------------
COUNT_VST3=0
COUNT_LV2=0
COUNT_CLAP=0
COUNT_BIN=0

# ---- Utility functions -----------------------------------------------------
log() {
    if $DRY_RUN; then
        echo -e "${YELLOW}[DRY-RUN]${NC} $1"
    else
        echo -e "${GREEN}[DEPLOY]${NC} $1"
    fi
}

deploy_item() {
    local src="$1"
    local dst="$2"
    local label="$3"

    # If the destination already exists and is identical, skip
    # (except in dry-run where we want to see what would be deployed)
    if ! $DRY_RUN && [ -e "$dst" ] && [ "$MODE" = "copy" ]; then
        if [ -d "$src" ] && [ -d "$dst" ]; then
            if diff -rq "$src" "$dst" &>/dev/null; then
                return
            fi
        elif [ -f "$src" ] && [ -f "$dst" ]; then
            if cmp -s "$src" "$dst"; then
                return
            fi
        fi
    fi

    if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf "$dst"
    fi

    if $DRY_RUN; then
        if [ "$MODE" = "copy" ]; then
            echo "         cp -r '${src}' '${dst}'"
        else
            echo "         ln -s '${src}' '${dst}'"
        fi
    else
        if [ "$MODE" = "copy" ]; then
            cp -r "$src" "$dst"
        else
            ln -s "$src" "$dst"
        fi
    fi

    case "$label" in
        VST3) COUNT_VST3=$((COUNT_VST3 + 1)) ;;
        LV2)  COUNT_LV2=$((COUNT_LV2 + 1))   ;;
        CLAP) COUNT_CLAP=$((COUNT_CLAP + 1)) ;;
        BIN)  COUNT_BIN=$((COUNT_BIN + 1))   ;;
    esac
}

# =============================================================================
# DETECTION AND DEPLOYMENT OF A PLUGIN
#
# For a given folder in Native_Linux/, we test ALL possible organization
# patterns and deploy whatever matches.
# =============================================================================
deploy_plugin_dir() {
    local plugin_dir="$1"
    local plugin_name
    plugin_name=$(basename "$plugin_dir")

    # --- Pattern 1: The folder is ITSELF a .vst3 bundle ----------------------
    if [[ "$plugin_name" == *.vst3 ]]; then
        local dst="$VST3_DIR/$plugin_name"
        log "VST3 : $plugin_name → $dst"
        deploy_item "$plugin_dir" "$dst" "VST3"
        return
    fi

    # --- Pattern 2: Multi-arch folder (Bertom-style) -------------------------
    #    .sse2/Plugin.vst3, .avx2/Plugin.vst3, .arm64/Plugin.vst3
    if [ -n "$ARCH_DIR" ]; then
        local arch_path="$plugin_dir/$ARCH_DIR"
        if [ -d "$arch_path" ]; then
            local found=false
            while IFS= read -r -d '' vst3_bundle; do
                local bundle_name
                bundle_name=$(basename "$vst3_bundle")
                local dst="$VST3_DIR/$bundle_name"
                log "VST3 (${ARCH_DIR#.}) : $bundle_name → $dst"
                deploy_item "$vst3_bundle" "$dst" "VST3"
                found=true
            done < <(find "$arch_path" -maxdepth 2 -name "*.vst3" -type d -print0 2>/dev/null)

            if $found; then
                return  # Do not look for other patterns, the arch takes priority
            fi
        fi
    fi

    # --- Pattern 3: Standard sub-folders LV2/, VST3/, CLAP/, Standalone/ -----
    #     (structure used by ZL Devices, and many plugins)
    local has_standard_subdirs=false

    # LV2/
    if [ -d "$plugin_dir/LV2" ]; then
        has_standard_subdirs=true
        while IFS= read -r -d '' lv2_bundle; do
            local name
            name=$(basename "$lv2_bundle")
            local dst="$LV2_DIR/$name"
            log "LV2 : $name → $dst"
            deploy_item "$lv2_bundle" "$dst" "LV2"
        done < <(find "$plugin_dir/LV2" -maxdepth 2 -name "*.lv2" -type d -print0 2>/dev/null)
    fi

    # VST3/
    if [ -d "$plugin_dir/VST3" ]; then
        has_standard_subdirs=true
        while IFS= read -r -d '' vst3_bundle; do
            local name
            name=$(basename "$vst3_bundle")
            local dst="$VST3_DIR/$name"
            log "VST3 : $name → $dst"
            deploy_item "$vst3_bundle" "$dst" "VST3"
        done < <(find "$plugin_dir/VST3" -maxdepth 2 -name "*.vst3" -type d -print0 2>/dev/null)
    fi

    # CLAP/
    if [ -d "$plugin_dir/CLAP" ]; then
        has_standard_subdirs=true
        while IFS= read -r -d '' clap_file; do
            local name
            name=$(basename "$clap_file")
            local dst="$CLAP_DIR/$name"
            log "CLAP : $name → $dst"
            deploy_item "$clap_file" "$dst" "CLAP"
        done < <(find "$plugin_dir/CLAP" -maxdepth 2 \( -name "*.clap" -o -name "*.so" \) -type f -print0 2>/dev/null)
    fi

    # Standalone/
    if [ -d "$plugin_dir/Standalone" ]; then
        has_standard_subdirs=true
        while IFS= read -r -d '' bin_file; do
            if [ -x "$bin_file" ]; then
                local name
                name=$(basename "$bin_file")
                local dst="$BIN_DIR/$name"
                log "BIN : $name → $dst"
                deploy_item "$bin_file" "$dst" "BIN"
            fi
        done < <(find "$plugin_dir/Standalone" -maxdepth 2 -type f -print0 2>/dev/null)
    fi

    if $has_standard_subdirs; then
        return
    fi

    # --- Pattern 4: Flat bundles at the root of the folder -------------------
    #    (structure used by Dragonfly, TAL-Reverb-4, etc.)
    local has_flat_bundles=false

    # Flat .vst3 bundles
    while IFS= read -r -d '' vst3_bundle; do
        has_flat_bundles=true
        local name
        name=$(basename "$vst3_bundle")
        local dst="$VST3_DIR/$name"
        log "VST3 : $name → $dst"
        deploy_item "$vst3_bundle" "$dst" "VST3"
    done < <(find "$plugin_dir" -maxdepth 1 -name "*.vst3" -type d -print0 2>/dev/null)

    # Flat .lv2 bundles
    while IFS= read -r -d '' lv2_bundle; do
        has_flat_bundles=true
        local name
        name=$(basename "$lv2_bundle")
        local dst="$LV2_DIR/$name"
        log "LV2 : $name → $dst"
        deploy_item "$lv2_bundle" "$dst" "LV2"
    done < <(find "$plugin_dir" -maxdepth 1 -name "*.lv2" -type d -print0 2>/dev/null)

    # Flat .clap files (and their companion .so)
    while IFS= read -r -d '' clap_file; do
        has_flat_bundles=true
        local name
        name=$(basename "$clap_file")
        local dst="$CLAP_DIR/$name"
        log "CLAP : $name → $dst"
        deploy_item "$clap_file" "$dst" "CLAP"
    done < <(find "$plugin_dir" -maxdepth 1 -name "*.clap" -type f -print0 2>/dev/null)

    # Companion .so libraries of the .clap files (e.g. libTAL-Reverb-4.so)
    # Only libraries starting with "lib" are CLAP dependencies
    # Files like DragonflyEarlyReflections-vst.so are VST2 wrappers
    while IFS= read -r -d '' so_file; do
        local so_name
        so_name=$(basename "$so_file")
        if [[ "$so_name" == lib* ]] && find "$plugin_dir" -maxdepth 1 -name "*.clap" -type f 2>/dev/null | grep -q .; then
            local dst="$CLAP_DIR/$so_name"
            log "CLAP lib : $so_name → $dst"
            deploy_item "$so_file" "$dst" "CLAP"
        fi
    done < <(find "$plugin_dir" -maxdepth 1 -name "*.so" -type f -print0 2>/dev/null)

    if $has_flat_bundles; then
        return
    fi

    # --- Pattern 5: Standalone executables directly at the root --------------
    local has_bins=false
    while IFS= read -r -d '' bin_file; do
        if [ -x "$bin_file" ] && [ ! -d "$bin_file" ] && [[ ! "$bin_file" == *.sh ]] && [[ ! "$bin_file" == *.md ]] && [[ ! "$bin_file" == *.txt ]]; then
            has_bins=true
            local name
            name=$(basename "$bin_file")
            local dst="$BIN_DIR/$name"
            log "BIN : $name → $dst"
            deploy_item "$bin_file" "$dst" "BIN"
        fi
    done < <(find "$plugin_dir" -maxdepth 1 -type f -print0 2>/dev/null)

    if ! $has_bins; then
        # If nothing was deployed at all, report it
        echo -e "${YELLOW}  ⚠ $plugin_name: no recognized format (ignored)${NC}"
    fi
}

# =============================================================================
# BRIDGED DEPLOYMENT (yabridge)
# =============================================================================
deploy_bridged() {
    echo -e "\n${CYAN}═══════════════ Bridged Windows (yabridge) ═══════════════${NC}"
    [ -d "$BRIDGED_DIR" ] || { echo -e "${YELLOW}  No Bridged_Windows/ folder found.${NC}"; return; }

    local bridged_vst3="$VST3_DIR/bridged"
    if ! $DRY_RUN; then
        mkdir -p "$bridged_vst3"
    fi
    log "Target folder: $bridged_vst3"

    local found=false

    # Standalone .vst3 files at the root
    while IFS= read -r -d '' f; do
        local name
        name=$(basename "$f")
        local dst="$bridged_vst3/$name"
        log "VST3 : $name → $dst"
        deploy_item "$f" "$dst" "VST3"
        found=true
    done < <(find "$BRIDGED_DIR" -maxdepth 1 -name "*.vst3" -type f -print0 2>/dev/null)

    # Plugin folders
    while IFS= read -r -d '' d; do
        local dir_name
        dir_name=$(basename "$d")
        local dst="$bridged_vst3/$dir_name"

        # Contains .dll or .vst3 directly -> folder link
        if ls "$d"/*.dll "$d"/*.vst3 2>/dev/null >/dev/null; then
            log "Plugin : $dir_name → $dst"
            deploy_item "$d" "$dst" "VST3"
            found=true
        # TDR structure (VST2/, VST3/, AAX/) -> folder link
        elif [ -d "$d/VST3" ] || [ -d "$d/VST2" ]; then
            log "Plugin : $dir_name → $dst"
            deploy_item "$d" "$dst" "VST3"
            found=true
        fi
    done < <(find "$BRIDGED_DIR" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)

    if ! $found; then
        echo -e "${YELLOW}  No bridged plugin found.${NC}"
    fi

    echo -e "\n${YELLOW}  ⚠  Don't forget to configure yabridge:"
    echo -e "      yabridgectl add \"$bridged_vst3\""
    echo -e "      yabridgectl sync${NC}"
}

# =============================================================================
# CLEANUP
# =============================================================================
cleanup_dead_links() {
    echo -e "${CYAN}═══════════════ Cleaning dead links ═════════════════${NC}"
    local total=0
    for dir in "$VST3_DIR" "$LV2_DIR" "$CLAP_DIR" "$VST_DIR" "$BIN_DIR"; do
        if [ -d "$dir" ]; then
            local count
            count=$(find -L "$dir" -maxdepth 2 -type l 2>/dev/null | wc -l)
            if [ "$count" -gt 0 ]; then
                if $DRY_RUN; then
                    echo -e "${YELLOW}[DRY-RUN]${NC} Would delete $count link(s) in $dir"
                else
                    find -L "$dir" -maxdepth 2 -type l -delete 2>/dev/null || true
                    echo -e "${GREEN}[CLEAN]${NC} $count dead link(s) deleted in $dir"
                fi
                total=$((total + count))
            fi
        fi
    done
    if [ "$total" -eq 0 ]; then
        echo -e "  No dead link found."
    fi
}

# =============================================================================
# SUMMARY DISPLAY
# =============================================================================
print_summary() {
    echo -e "\n${GREEN}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  Deployment complete!${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"

    echo -e "\n${CYAN}Summary:${NC}"
    echo -e "  VST3 → $VST3_DIR  ($COUNT_VST3 deployed)"
    echo -e "  LV2  → $LV2_DIR   ($COUNT_LV2 deployed)"
    echo -e "  CLAP → $CLAP_DIR  ($COUNT_CLAP deployed)"
    echo -e "  BIN  → $BIN_DIR   ($COUNT_BIN deployed)"

        if [ "$MODE" = "symlink" ]; then
            echo -e "\n${YELLOW}⚠  Symbolic links — do not move/delete the folder"
            echo -e "   Audio_Plugins/ after deployment.${NC}"
        fi
}

# =============================================================================
# MAIN
# =============================================================================
echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║        Audio plugin deployment — Dynamic        ║${NC}"
echo -e "${CYAN}╠══════════════════════════════════════════════════════════╣${NC}"
if [ "$MODE" = "symlink" ]; then
    echo -e "${CYAN}║  Mode: symbolic links${NC}"
else
    echo -e "${CYAN}║  Mode: real copy${NC}"
fi
if $DRY_RUN; then
    echo -e "${CYAN}║  Simulation: YES${NC}"
fi
if $DEPLOY_BRIDGED; then
    echo -e "${CYAN}║  Bridged: YES${NC}"
fi
echo -e "${CYAN}║  Architecture: $ARCH${NC}"
[ -n "$ARCH_DIR" ] && echo -e "${CYAN}║  Optimization: ${ARCH_DIR#.}${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"

# --clean mode only
if $CLEAN_ONLY; then
    cleanup_dead_links
    exit 0
fi

# Scan Native_Linux/
if [ -d "$NATIVE_DIR" ]; then
    echo -e "\n${CYAN}═══════════════ Native Linux plugins ═══════════════${NC}"
    while IFS= read -r -d '' plugin_dir; do
        name=$(basename "$plugin_dir")
        echo -e "\n${CYAN}── $name ──${NC}"
        deploy_plugin_dir "$plugin_dir"
    done < <(find "$NATIVE_DIR" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)
else
    echo -e "\n${RED}Error: Native_Linux/ folder not found in $REPO_DIR${NC}"
    exit 1
fi

# Bridged (optional)
if $DEPLOY_BRIDGED; then
    deploy_bridged
fi

# Cleanup
cleanup_dead_links

# Summary
print_summary
