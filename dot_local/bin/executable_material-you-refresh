#!/bin/sh
# material-you-refresh — manually re-sync kitty/btop/prompt to the current
# Material You colors. Safety net if the kde-material-you-colors daemon did not
# run (crash, partial startup).
set -e

echo "==> Generating kitty + btop + prompt with the current colors"
python3 "$HOME/.local/bin/kitty-material-you.py"
python3 "$HOME/.local/bin/btop-material-you.py"
python3 "$HOME/.local/bin/material-you-prompt.py"

echo "==> Reload kitty (open instances + reload)"
pkill -USR1 -x kitty 2>/dev/null || true
kitten @ set-colors --all "$HOME/.config/kitty/theme-wallpaper.conf" 2>/dev/null || true

echo "==> Prompt: cache re-read on next prompt"
echo "OK — kitty/btop/prompt resynchronized."
