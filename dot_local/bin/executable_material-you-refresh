#!/bin/sh
# material-you-refresh — manually re-sync kitty/btop/prompt to the current
# Material You colors. Safety net if the kde-material-you-colors daemon did not
# run (crash, partial startup).
set -e

echo "==> Generating kitty + btop + zed + zen + prompt with the current colors"
# Generators are internal: they live in ~/.local/lib/material-you/, not on PATH.
MY_LIB="$HOME/.local/lib/material-you"
python3 "$MY_LIB/kitty.py"
python3 "$MY_LIB/btop.py"
python3 "$MY_LIB/zed.py"
python3 "$MY_LIB/zen.py"
python3 "$MY_LIB/prompt.py"

echo "==> Reload kitty (open instances + reload)"
pkill -USR1 -x kitty 2>/dev/null || true
kitten @ set-colors --all "$HOME/.config/kitty/theme-wallpaper.conf" 2>/dev/null || true

echo "==> Prompt: cache re-read on next prompt"
echo "==> Zen: user.js + userChrome written (restart Zen to apply)"

# user.js and userChrome.css are only read at startup: remind the user instead
# of letting them wonder why a running Zen does not follow the wallpaper.
if pgrep -x zen-bin >/dev/null 2>&1 && command -v notify-send >/dev/null 2>&1; then
  notify-send -a "Material You" "Zen : relance-le pour les nouvelles couleurs" \
    "user.js / userChrome.css ne sont lus qu'au démarrage."
fi

echo "OK — kitty/btop/zed/zen/prompt resynchronized."
