# Portable git config: identity is deliberately absent (this file can live in a
# public repo). Put yours in ~/.config/git/local, which the include below pulls
# in; a missing include file is silently ignored by git.
[include]
	path = ~/.config/git/local

[init]
	defaultBranch = main

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gitlab.freedesktop.org"]
	helper =
	helper = !/usr/bin/glab auth git-credential

[alias]
	st = status
	lg = log --oneline --graph --decorate
	co = checkout
	sw = switch
	br = branch
	ci = commit
	ca = commit --amend --no-edit
	psh = push
	pl = pull --ff-only
	df = diff
	aa = add -A
	last = log -1 HEAD --stat
