# =============================================================================
# .zshrc — portable copy
#
# Zsh for any Linux box (Arch, Fedora, Debian/Mint, a container, a VM). It
# contains none of the machine-specific pieces of the main repo: no Limine, no
# omenctl, no KDE/Material You, no Arch-only paths baked in.
#
# Optional pieces (p10k, the plugins, fzf, zoxide) are looked up in the usual
# per-distro locations. When one is missing it is reported once on stderr
# instead of being silently dropped.
#
# Apply with:  chezmoi --source <repo>/portable apply
# =============================================================================

# --- Powerlevel10k: no instant prompt ---------------------------------------
# The instant prompt shows a *cached* prompt from the previous session and
# replaces it once the real one is ready. Fastfetch prints during startup, and
# that replacement is what made the first prompt intermittently show a stale one
# (plain, or from an older directory). Rendering the live prompt costs a few
# milliseconds and is always right.
typeset -g POWERLEVEL9K_INSTANT_PROMPT=off

# --- Helpers ----------------------------------------------------------------
# Source the first readable candidate.
_zsh_source_first() {
  local f
  for f in "$@"; do
    [[ -r $f ]] && { source "$f"; return 0; }
  done
  return 1
}

_zsh_warn() {
  print -u2 -- "zshrc: $*"
}

# Where the usual distros put the optional pieces.
_zsh_autosuggestions=(
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
)
_zsh_syntax_highlighting=(
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
)
_zsh_substring_search=(
  /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
  /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh
  /usr/local/share/zsh-history-substring-search/zsh-history-substring-search.zsh
  /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
)
_zsh_p10k=(
  /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
  /usr/share/powerlevel10k/powerlevel10k.zsh-theme
  /usr/local/share/powerlevel10k/powerlevel10k.zsh-theme
  $HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme
  $HOME/.oh-my-zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme
)

# --- PATH -------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# --- Options ----------------------------------------------------------------
# interactive_comments matters: the README's install blocks are pasted without
# `#` for exactly this reason.
setopt autocd interactive_comments extendedglob completealiases

# --- History ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history inc_append_history share_history hist_ignore_dups
HISTORY_IGNORE="(&|[bf]g|c|clear|history|exit|q|pwd|* --help)"

# --- Completion -------------------------------------------------------------
_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}"
[[ -d $_zsh_cache ]] || mkdir -p "$_zsh_cache"

autoload -Uz compinit
compinit -d "$_zsh_cache/zcompdump-${ZSH_VERSION}"

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_zsh_cache/zcompcache"
[[ -n $LS_COLORS ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- Plugins ----------------------------------------------------------------
# zle-dependent: only in interactive shells, and after compinit.
if [[ -o interactive ]]; then
  _zsh_source_first "${_zsh_syntax_highlighting[@]}" ||
    _zsh_warn "zsh-syntax-highlighting not found (install the distro package)"

  _zsh_source_first "${_zsh_autosuggestions[@]}" ||
    _zsh_warn "zsh-autosuggestions not found (install the distro package)"

  if _zsh_source_first "${_zsh_substring_search[@]}"; then
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
  fi

  # fzf: Ctrl+R (history), Ctrl+T (files), Alt+C (cd) + fuzzy completion
  if _zsh_source_first \
      /usr/share/fzf/key-bindings.zsh \
      /usr/share/fzf/shell/key-bindings.zsh \
      /usr/share/doc/fzf/examples/key-bindings.zsh \
      /opt/homebrew/opt/fzf/shell/key-bindings.zsh; then
    _zsh_source_first \
      /usr/share/fzf/completion.zsh \
      /usr/share/fzf/shell/completion.zsh \
      /usr/share/doc/fzf/examples/completion.zsh \
      /opt/homebrew/opt/fzf/shell/completion.zsh
  fi
fi

# zoxide: `z <dir>` jumps to visited dirs, `zi` picks with fzf
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# --- Prompt -----------------------------------------------------------------
if _zsh_source_first "${_zsh_p10k[@]}"; then
  # Generated by `p10k configure` (run it once on a fresh machine).
  [[ -r ~/.p10k.zsh ]] && source ~/.p10k.zsh
else
  _zsh_warn "powerlevel10k not found — keeping the default zsh prompt"
fi

# --- Handy bits -------------------------------------------------------------
# extract any archive
extract() {
  [[ -f $1 ]] || { print -u2 "extract: no such file: $1"; return 1 }
  case $1 in
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar.gz|*.tgz)   tar xzf "$1" ;;
    *.tar.xz|*.txz)   tar xJf "$1" ;;
    *.tar.zst|*.tzst) tar --zstd -xf "$1" ;;
    *.tar)            tar xf "$1" ;;
    *.bz2)            bunzip2 "$1" ;;
    *.gz)             gunzip "$1" ;;
    *.xz)             unxz "$1" ;;
    *.zst)            unzstd "$1" ;;
    *.zip)            unzip "$1" ;;
    *.7z)             7z x "$1" ;;
    *.rar)            unrar x "$1" ;;
    *) print -u2 "extract: unknown archive type: $1"; return 1 ;;
  esac
}

# Colored man pages (no-op when tput or the terminfo entry is unavailable)
if (( $+commands[tput] )); then
  export LESS_TERMCAP_md="$(tput bold 2>/dev/null)$(tput setaf 2 2>/dev/null)"
  export LESS_TERMCAP_me="$(tput sgr0 2>/dev/null)"
fi

# --- Aliases ----------------------------------------------------------------
alias ls='ls --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
(( $+commands[fastfetch] )) && alias ff='fastfetch'

# --- Machine-specific fragment (optional) ------------------------------------
# The machine layer ships ~/.config/zsh/machine.zsh: Material You prompt colors,
# pkgfile, and the Limine/omenctl aliases. Absent on a plain userspace install.
[[ -r ~/.config/zsh/machine.zsh ]] && source ~/.config/zsh/machine.zsh

# --- Local secrets (never versioned) ---------------------------------------
[[ -f ~/.config/zsh/secrets ]] && source ~/.config/zsh/secrets

# --- MOTD -------------------------------------------------------------------
# Last, and interactive only: anything printing earlier breaks the p10k
# instant prompt.
if [[ -o interactive ]] && (( $+commands[fastfetch] )); then
  fastfetch
fi
