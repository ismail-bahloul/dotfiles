# Run fastfetch only in interactive terminals
if [[ $- == *i* ]]; then
  fastfetch
fi

# Add local bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- zsh stack: p10k + plugins (self-contained) ------------------------------
# Replaces `source /usr/share/cachyos-zsh-config/cachyos-config.zsh`. That file
# ships in a CachyOS package we do not manage (not in packages.d/base.pacman) and
# depends on 11 packages (oh-my-zsh-git, vim + vim-runtime, powerline-fonts...)
# for ~100 lines of config. Everything we actually use is below, each source
# guarded, so a missing package can never break the shell again.
[[ -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]] &&
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Completion (previously pulled in by oh-my-zsh). Cached dump in XDG_CACHE_HOME.
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump-${ZSH_VERSION}"

# Completion behaviour (previously oh-my-zsh/lib/completion.zsh)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
[[ -n $LS_COLORS ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zcompcache"

# Shell behaviour: type a directory to cd, `#` comments at the prompt,
# extended globbing, and Tab completion on aliases.
setopt autocd interactive_comments extendedglob completealiases

# History: shared between shells, no duplicates, ignore noisy commands.
# HISTFILE/HISTSIZE/SAVEHIST used to come from oh-my-zsh's lib/history.zsh.
# zsh's own defaults are HISTSIZE=30, SAVEHIST=0 and no HISTFILE, so without
# these three lines nothing is loaded or persisted across sessions.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
HISTORY_IGNORE="(&|[bf]g|c|clear|history|exit|q|pwd|* --help)"
setopt extended_history inc_append_history share_history hist_ignore_dups

# Fish-like syntax highlighting + autosuggestions
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# History substring search on Up/Down
if [[ -r /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# fzf: Ctrl+R (history), Ctrl+T (files), Alt+C (cd) + fuzzy completion
[[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -r /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

# zoxide: `z <dir>` jumps to visited dirs, `zi` picks with fzf
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# extract any archive (the one oh-my-zsh helper actually worth keeping)
extract() {
  [[ -f $1 ]] || { print -u2 "extract: no such file: $1"; return 1 }
  case $1 in
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar.gz|*.tgz)   tar xzf "$1" ;;
    *.tar.xz|*.txz)   tar xJf "$1" ;;
    *.tar.zst|*.tzst) tar --zstd -xf "$1" ;;
    *.tar)            tar xf "$1" ;;
    *.bz2)            bunzip2 "$1" ;;
    *.gz)             gunzip "$1" ;;
    *.xz)             unxz "$1" ;;
    *.zst)            unzstd "$1" ;;
    *.zip)            unzip "$1" ;;
    *.7z)             7z x "$1" ;;
    *.rar)            unrar x "$1" ;;
    *) print -u2 "extract: unknown archive type: $1"; return 1 ;;
  esac
}

# pkgfile "command not found" handler
[[ -r /usr/share/doc/pkgfile/command-not-found.zsh ]] &&
  source /usr/share/doc/pkgfile/command-not-found.zsh

# Colored man pages
export LESS_TERMCAP_md="$(tput bold 2>/dev/null; tput setaf 2 2>/dev/null)"
export LESS_TERMCAP_me="$(tput sgr0 2>/dev/null)"

# --- p10k prompt + ls colors: follow the Material You accent of the wallpaper ---
# `prompt.py` (triggered by kde-material-you-colors) writes the p10k
# colors AND LS_COLORS derived from the same palette. Here we only "source" the
# file -> no process launched on every prompt.
_prompt_material() {
  local cache="$HOME/.cache/material-you/prompt.zsh"
  [[ -f "$cache" ]] && source "$cache"
  [[ -n $LS_COLORS ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
}
_prompt_material
[[ " ${precmd_functions[*]} " == *" _prompt_material "* ]] || precmd_functions+=(_prompt_material)

alias ff='fastfetch'
alias material-refresh='$HOME/.local/bin/material-you-refresh'

# ls: colors come from LS_COLORS (Material You, refreshed with the wallpaper)
alias ls='ls --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# Source local secrets (API keys, tokens) — not versioned
[[ -f ~/.config/zsh/secrets ]] && source ~/.config/zsh/secrets

# --- Boot to Windows (via Limine) ---
alias ww="limine-boot-win"

# --- Boot to VFIO kernel (GPU passthrough) ---
alias vv="limine-boot-vfio"

# --- Boot to default Linux kernel ---
alias ll="limine-boot-linux"

# --- Backup & Power ---
alias backup="backup-data"
alias power="sudo omenctl status"
alias auto="sudo omenctl profile auto && sudo omenctl status"
alias quiet="sudo omenctl profile quiet && sudo omenctl status"
alias eco="sudo omenctl profile eco && sudo omenctl status"
alias perf="sudo omenctl profile perf && sudo omenctl status"

# --- CachyOS : mise à jour complète (dépôts + AUR + Flatpak + nettoyage) ---
alias uu='$HOME/DATA/05_Code/Projects/arch-auto-update/arch-auto-update'
