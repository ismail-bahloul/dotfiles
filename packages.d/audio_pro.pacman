# =============================================================================
# packages.d/audio_pro.pacman — PipeWire/JACK audio stack.
# Component: audio_pro. Dropping the component also skips the `realtime` group
# in run_once_01 and the configs in dot_config/{pipewire,wireplumber}.
# Installed by run_once_01-packages.sh.tmpl
#
# Applications (REAPER, plugins) are NOT here: they are opt-in bricks, see
# bricks/audio-apps.*
# =============================================================================

# --- PipeWire JACK interface (replaces jack2, see run_once_01) ---------------
pipewire-jack                   # JACK interface over pipewire
lib32-pipewire-jack             # 32-bit layer for yabridge (32-bit VST)

# --- Realtime / latency ------------------------------------------------------
realtime-privileges             # provides the `realtime` group (run_once_01)
rtirq                           # IRQ priority for audio interfaces

# --- Wine support ------------------------------------------------------------
samba                           # winbind (ntlm_auth) for Wine - required by some VST plugins
