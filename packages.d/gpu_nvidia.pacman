# =============================================================================
# packages.d/gpu_nvidia.pacman — NVIDIA driver stack (the dGPU drives the screen).
# Component: gpu_nvidia — no mode-switching here, this machine always has the
# dGPU wired to the panel. Drop the component on a machine without one.
# Installed by run_once_01-packages.sh.tmpl
# =============================================================================

libva-nvidia-driver             # VA-API hardware acceleration for NVIDIA (Wayland)
lib32-nvidia-utils              # 32-bit NVIDIA layer (Wine, Steam)
opencl-nvidia                   # NVIDIA compute
lib32-opencl-nvidia
