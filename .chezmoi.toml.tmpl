# =============================================================================
# .chezmoi.toml.tmpl — seeded into ~/.config/chezmoi/chezmoi.toml by
# `chezmoi init` (only when that file does not already exist).
#
# `components` selects what this machine installs. Every entry is a file in
# packages.d/ (packages.d/<name>.pacman, plus .aur when it has AUR packages):
# adding a component to this list, or removing one, is the whole switch.
# `base` is always installed and is therefore not listed here.
#
# Turning a component off stops its packages from being installed on the next
# apply. It does NOT uninstall what is already there — see README, "Components".
#
# No prompt is used on purpose: `chezmoi init --apply` runs from install.sh and
# must never block waiting for an answer. (An interactive selector is the next
# step; it fills this same list.)
# =============================================================================

[data]
    # Legacy switch, still honoured: `wine = true` is equivalent to adding
    # "wine" to the components list.
    wine = false

    components = [
        "shell",             # zsh + powerlevel10k + plugins
        "monitoring",        # btop, nvtop, duf, fastfetch, plocate
        "gpu_nvidia",        # NVIDIA driver stack (dGPU)
        "hardware_amd",      # iGPU Vulkan, ucode, ryzenadj/SMU
        "audio_pro",         # PipeWire/JACK pro-audio chain + VST plugins
        "virtualization",    # QEMU/libvirt (host side of the VM)
        "containers",        # podman, distrobox
        "network_security",  # ufw, Proton VPN
        "apps",              # firefox, zed, obsidian, bitwarden, localsend…
        "creative",          # blender, OBS, upscayl, shutter-encoder
        "peripherals",       # logiops (MX Master 3S)
        "looking_glass",     # Looking Glass host client (IVSHMEM)
    ]
